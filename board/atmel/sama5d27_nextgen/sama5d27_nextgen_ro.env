loadaddr=0x22000000
krnladdr=0x23000000
bootcmd=setenv bootargs console=ttyS0,576000 initcall_debug ignore_loglevel loglevel=8 consoleblank=0 root=/dev/mmcblk0p2 rootfstype=squashfs ro rootwait nextgen.env=sd-ro nextgen.manufacturer=${manufacturer} nextgen.modeltype=${modeltype} nextgen.model=${model}; fatload mmc 0:1 ${loadaddr} nextgen.dtb; fatload mmc 0:1 ${krnladdr} zImage; bootz ${krnladdr} - ${loadaddr}
bootdelay=-2
silent=1
manufacturer=castle
modeltype=0
model=0

baudrate=576000

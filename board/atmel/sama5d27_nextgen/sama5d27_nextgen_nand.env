loadaddr=0x22000000
krnladdr=0x23000000
bootcmd=setenv bootargs console=ttyS0,576000 quiet loglevel=3 consoleblank=0 ubi.mtd=rootfs root=ubi0:rootfs rootfstype=ubifs rw nextgen.env=nand nextgen.manufacturer=${manufacturer} nextgen.modeltype=${modeltype} nextgen.model=${model}; fatload mmc 0:1 ${loadaddr} nextgen.dtb; fatload mmc 0:1 ${krnladdr} zImage; bootz ${krnladdr} - ${loadaddr}
bootdelay=-2
silent=1
manufacturer=castle
modeltype=0
model=0

baudrate=576000

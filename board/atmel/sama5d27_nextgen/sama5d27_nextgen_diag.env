loadaddr=0x22000000
krnladdr=0x23000000
bootcmd=echo *** NextGen U-Boot diagnostic start ***; echo Loading DTB from mmc 0:1; fatload mmc 0:1 ${loadaddr} nextgen.dtb; echo Loading kernel from mmc 0:1; fatload mmc 0:1 ${krnladdr} zImage; echo Setting bootargs; setenv bootargs console=ttyS0,576000 loglevel=7 consoleblank=0 root=/dev/mmcblk0p2 rw rootwait nextgen.product=${product} nextgen.manufacturer=${manufacturer}; echo Entering bootz; bootz ${krnladdr} - ${loadaddr}
bootdelay=0
product=sonik-light
manufacturer=castle

baudrate=576000

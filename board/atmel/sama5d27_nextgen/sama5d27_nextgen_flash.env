loadaddr=0x22000000
krnladdr=0x23000000
bootcmd=setenv bootargs console=ttyS0,576000 quiet loglevel=3 consoleblank=0 ubi.mtd=rootfs root=ubi0:rootfs rootfstype=ubifs rootflags=bulk_read rw nextgen.env=flash nextgen.manufacturer=${manufacturer} nextgen.modeltype=${modeltype} nextgen.model=${model}; mtd read device-tree ${loadaddr}; mtd read kernel ${krnladdr}; bootz ${krnladdr} - ${loadaddr}
bootdelay=-2
silent=1
manufacturer=castle
modeltype=0
model=0

baudrate=576000

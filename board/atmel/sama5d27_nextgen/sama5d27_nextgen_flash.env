loadaddr=0x22000000
krnladdr=0x23000000
bootcmd=setenv bootargs console=ttyS0,576000 quiet loglevel=3 consoleblank=0 ubi.mtd=rootfs ubi.block=0,system root=/dev/ubiblock0_0 rootfstype=squashfs ro nextgen.env=flash nextgen.manufacturer=${manufacturer} nextgen.modeltype=${modeltype} nextgen.model=${model} && ubi part boot && ubi read ${loadaddr} device-tree && ubi read ${krnladdr} kernel && bootz ${krnladdr} - ${loadaddr}
bootdelay=-2
silent=1
manufacturer=castle
modeltype=0
model=0

baudrate=576000

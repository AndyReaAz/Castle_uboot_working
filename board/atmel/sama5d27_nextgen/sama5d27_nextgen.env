loadaddr=0x22000000
krnladdr=0x23000000
ramdiskaddr=0x24000000

bootargs_common=console=ttyS0,115200 consoleblank=0

bootargs_nand=root=ubi0:rootfs rootfstype=ubifs ubi.mtd=rootfs rw
bootargs_mmc=root=/dev/mmcblk0p2 rw rootwait

bootcmd_nand=setenv bootargs ${bootargs_common} ${bootargs_nand} nextgen.product=${product} nextgen.manufacturer=${manufacturer}; \
            mtd read spi-nand0 ${loadaddr} 0x0 0x80000; \
            mtd read spi-nand0 ${krnladdr} 0x80000 0x800000; \
            bootz ${krnladdr} - ${loadaddr}

bootcmd_mmc=setenv bootargs ${bootargs_common} ${bootargs_mmc} nextgen.product=${product} nextgen.manufacturer=${manufacturer}; \
            fatload mmc 0:1 ${loadaddr} nextgen.dtb; \
            fatload mmc 0:1 ${krnladdr} zImage; \
            fatload mmc 0:1 ${ramdiskaddr} psplash-initramfs.cpio.gz; \
            setenv ramdisksize ${filesize}; \
            bootz ${krnladdr} ${ramdiskaddr}:${ramdisksize} ${loadaddr}

showlogo=mmc dev 0; \
         fatload mmc 0:1 ${loadaddr} ${product}.bmp; \
         bmp display ${loadaddr}

bootcmd_nandwithmmc=setenv bootargs ${bootargs_common} ${bootargs_mmc} nextgen.product=${product} nextgen.manufacturer=${manufacturer}; \
                   mtd read spi-nand0 ${loadaddr} 0x0 0x80000; \
                   mtd read spi-nand0 ${krnladdr} 0x80000 0x800000; \
                   bootz ${krnladdr} - ${loadaddr}

bootcmd=run showlogo; run bootcmd_mmc
bootdelay=0

product=sonik-light
manufacturer=castle

ethaddr=70:B3:D5:01:00:01
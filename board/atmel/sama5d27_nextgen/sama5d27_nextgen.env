loadaddr=0x22000000
krnladdr=0x23000000
bootcmd=setenv bootargs console=ttyS0,576000 quiet loglevel=3 consoleblank=0 root=/dev/mmcblk0p2 rw rootwait nextgen.env=sd nextgen.product=${product} nextgen.manufacturer=${manufacturer}; fatload mmc 0:1 ${loadaddr} nextgen.dtb; fatload mmc 0:1 ${krnladdr} zImage; bootz ${krnladdr} - ${loadaddr}
bootdelay=-2
silent=1
product=sonik-light
manufacturer=castle

baudrate=576000

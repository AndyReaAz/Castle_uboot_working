loadaddr=0x22000000
krnladdr=0x23000000
bootdelay=-2
silent=1

manufacturer=castle
modeltype=0
model=0

bootargs_prod=console=ttyS0,576000 quiet loglevel=3 consoleblank=0 root=ubi0:rootfs rootfstype=ubifs ubi.mtd=rootfs ro nextgen.env=flash nextgen.manufacturer=${manufacturer} nextgen.modeltype=${modeltype} nextgen.model=${model}
load_prod=ubi part rootfs; ubifsmount ubi0:rootfs; ubifsload ${loadaddr} /boot/nextgen.dtb; ubifsload ${krnladdr} /boot/zImage
bootcmd=setenv bootargs ${bootargs_prod}; run load_prod; bootz ${krnladdr} - ${loadaddr}

baudrate=576000
